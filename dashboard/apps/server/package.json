{
  "name": "@agent-sandbox/dashboard-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:workspace": "tsup src/index.ts --format esm --out-dir dist --clean",
    "test:workspace": "vitest",
    "test:ci:workspace": "mkdir -p ../../test-results && vitest run --reporter=default --reporter=junit --outputFile.junit=../../test-results/server-junit.xml",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@agent-sandbox/dashboard-shared": "0.1.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@kubernetes/client-node": "^1.2.0",
    "fastify": "^5.3.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
